import Mathlib.NumberTheory.ArithmeticFunction.VonMangoldt
import Mathlib.NumberTheory.ArithmeticFunction.Moebius
import Mathlib.NumberTheory.Chebyshev
import Mathlib.RingTheory.RootsOfUnity.Complex
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-!
# Elementary identities: reachability by multiplication, von Mangoldt, primitive roots, lcm

Four classical facts, stated in Mathlib's terms. Two are already in Mathlib and are restated;
the module says which. Nothing here bounds `ψ(x) - x`, and nothing here bears on the Riemann
hypothesis.

* (a) **Reachability by multiplication.** `reachable_iff_not_prime`: for `n ≥ 2`, `n` is a
  product of two smaller numbers exactly when `n` is not prime. This is Mathlib's
  `Nat.not_prime_iff_exists_mul_eq` with the two sides exchanged.
  `mem_closure_smaller_iff_not_prime` is the same fact for products of any length: `n` lies
  in the multiplicative monoid generated by `1, …, n - 1` exactly when `n` is not prime.
* (b) **von Mangoldt as the innovation of `log`.**
  `vonMangoldt_eq_log_sub_sum_properDivisors`: `Λ(n) = log n - ∑_{d ∣ n, d < n} Λ(d)`.
  A one-line consequence of Mathlib's `ArithmeticFunction.vonMangoldt_sum`.
* (c) **The primitive roots of unity sum to Möbius.** `sum_primitiveRoots_eq_moebius`:
  `∑ ζ ∈ primitiveRoots n ℂ, ζ = μ(n)`. Mathlib has no statement of this (no Ramanujan
  sums); it is proved here by Möbius inversion.
* (d) **The least common multiple and `ψ`.** `log_lcm_Icc_eq_sum_vonMangoldt`:
  `log lcm(1, …, n) = ∑_{m ≤ n} Λ(m)`. This is Mathlib's `Chebyshev.psi_eq_log_lcmUpto`
  with `ψ` and `Nat.lcmUpto` unfolded. `log_lcm_succ_sub_log_lcm` is the one-step form:
  `log lcm(1, …, n + 1) - log lcm(1, …, n) = Λ(n + 1)`.
-/

set_option autoImplicit false

namespace BuildingBlocks.PrimeBirth

/-! ## (a) Reachability by multiplication -/

/-- For `n ≥ 2`: `n` is a product of two smaller numbers exactly when it is not prime.
(Mathlib: `Nat.not_prime_iff_exists_mul_eq`.) -/
theorem reachable_iff_not_prime {n : ℕ} (hn : 2 ≤ n) :
    (∃ a b, a < n ∧ b < n ∧ a * b = n) ↔ ¬ n.Prime :=
  (Nat.not_prime_iff_exists_mul_eq hn).symm

/-- For `n ≥ 2`: `n` is prime exactly when it is not a product of two smaller numbers. -/
theorem prime_iff_not_reachable {n : ℕ} (hn : 2 ≤ n) :
    n.Prime ↔ ¬ ∃ a b, a < n ∧ b < n ∧ a * b = n := by
  rw [reachable_iff_not_prime hn, not_not]

/-- For `n ≥ 2`: `n` lies in the multiplicative monoid generated by `1, …, n - 1` exactly
when it is not prime. So the monoid generated by `1, …, n` is strictly larger than the one
generated by `1, …, n - 1` exactly when `n` is prime. -/
theorem mem_closure_smaller_iff_not_prime {n : ℕ} (hn : 2 ≤ n) :
    n ∈ Submonoid.closure {m : ℕ | 1 ≤ m ∧ m < n} ↔ ¬ n.Prime := by
  constructor
  · intro hmem hp
    -- no element of the closure is divisible by the prime `n`
    have key : ∀ x ∈ Submonoid.closure {m : ℕ | 1 ≤ m ∧ m < n}, ¬ n ∣ x := by
      intro x hx
      induction hx using Submonoid.closure_induction with
      | mem m hm => exact Nat.not_dvd_of_pos_of_lt hm.1 hm.2
      | one => exact fun h => hp.one_lt.ne' (Nat.dvd_one.mp h)
      | mul a b _ _ iha ihb => exact fun h => (hp.dvd_mul.mp h).elim iha ihb
    exact key n hmem dvd_rfl
  · intro hnp
    obtain ⟨a, b, ha, hb, hab⟩ := (reachable_iff_not_prime hn).mpr hnp
    have ha1 : 1 ≤ a := by
      rcases Nat.eq_zero_or_pos a with rfl | h
      · omega
      · exact h
    have hb1 : 1 ≤ b := by
      rcases Nat.eq_zero_or_pos b with rfl | h
      · omega
      · exact h
    have hmem := Submonoid.mul_mem (Submonoid.closure {m : ℕ | 1 ≤ m ∧ m < n})
      (Submonoid.subset_closure ⟨ha1, ha⟩) (Submonoid.subset_closure ⟨hb1, hb⟩)
    rwa [hab] at hmem

/-! ## (b) von Mangoldt as the innovation of `log` -/

/-- `Λ(n) = log n - ∑_{d ∣ n, d < n} Λ(d)`: the von Mangoldt function is the part of `log n`
not accounted for by the proper divisors of `n`. Holds for every `n`, including `n = 0`.
(From Mathlib's `ArithmeticFunction.vonMangoldt_sum`.) -/
theorem vonMangoldt_eq_log_sub_sum_properDivisors (n : ℕ) :
    ArithmeticFunction.vonMangoldt n =
      Real.log n - ∑ d ∈ n.properDivisors, ArithmeticFunction.vonMangoldt d := by
  rcases eq_or_ne n 0 with rfl | hn
  · simp
  · have h := ArithmeticFunction.vonMangoldt_sum (n := n)
    rw [← Nat.cons_self_properDivisors hn, Finset.sum_cons] at h
    linarith

/-! ## (c) The primitive roots of unity sum to Möbius -/

/-- For `n > 1` the `n`-th roots of unity sum to zero. -/
theorem sum_nthRootsFinset_one_eq_zero {n : ℕ} (hn : 1 < n) :
    ∑ ζ ∈ Polynomial.nthRootsFinset n (1 : ℂ), ζ = 0 := by
  have hn0 : 0 < n := by omega
  have hζ := Complex.isPrimitiveRoot_exp n hn0.ne'
  set ζ₀ : ℂ := Complex.exp (2 * Real.pi * Complex.I / n) with hζ₀
  have hne : ζ₀ ≠ 1 := hζ.ne_one hn
  have h0 : ζ₀ ≠ 0 := hζ.ne_zero hn0.ne'
  -- multiplication by `ζ₀` permutes the roots
  have hmul : ∑ ζ ∈ Polynomial.nthRootsFinset n (1 : ℂ), ζ₀ * ζ =
      ∑ ζ ∈ Polynomial.nthRootsFinset n (1 : ℂ), ζ := by
    refine Finset.sum_nbij' (fun ζ => ζ₀ * ζ) (fun ζ => ζ₀⁻¹ * ζ) ?_ ?_ ?_ ?_ ?_
    · intro ζ hmem
      rw [Polynomial.mem_nthRootsFinset hn0] at hmem ⊢
      rw [mul_pow, hζ.pow_eq_one, hmem, one_mul]
    · intro ζ hmem
      rw [Polynomial.mem_nthRootsFinset hn0] at hmem ⊢
      rw [mul_pow, inv_pow, hζ.pow_eq_one, hmem, inv_one, one_mul]
    · intro ζ _
      rw [← mul_assoc, inv_mul_cancel₀ h0, one_mul]
    · intro ζ _
      rw [← mul_assoc, mul_inv_cancel₀ h0, one_mul]
    · intro ζ _
      rfl
  rw [← Finset.mul_sum] at hmul
  have hzero : (ζ₀ - 1) * ∑ ζ ∈ Polynomial.nthRootsFinset n (1 : ℂ), ζ = 0 := by
    linear_combination hmul
  exact (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr hne)

/-- Summing, over the divisors `d` of `n > 0`, the sums of the primitive `d`-th roots of
unity gives the sum of all `n`-th roots of unity: `1` if `n = 1`, and `0` otherwise. -/
theorem sum_divisors_sum_primitiveRoots {n : ℕ} (hn : 0 < n) :
    ∑ d ∈ n.divisors, ∑ ζ ∈ primitiveRoots d ℂ, ζ = if n = 1 then 1 else 0 := by
  classical
  rw [← Finset.sum_biUnion (fun a _ b _ hab => IsPrimitiveRoot.disjoint hab),
    ← IsPrimitiveRoot.nthRoots_one_eq_biUnion_primitiveRoots]
  split_ifs with h
  · subst h
    have h1 : Polynomial.nthRootsFinset 1 (1 : ℂ) = {1} := by
      ext x
      simp [Polynomial.mem_nthRootsFinset]
    rw [h1, Finset.sum_singleton]
  · exact sum_nthRootsFinset_one_eq_zero (by omega)

/-- **The primitive `n`-th roots of unity sum to `μ(n)`.** Holds for every `n`, including
`n = 0` (no primitive roots, and `μ(0) = 0`). This is the Ramanujan sum `c_n(1)`. -/
theorem sum_primitiveRoots_eq_moebius (n : ℕ) :
    ∑ ζ ∈ primitiveRoots n ℂ, ζ = (ArithmeticFunction.moebius n : ℂ) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  have key := (ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq (R := ℂ)
    (f := fun d => ∑ ζ ∈ primitiveRoots d ℂ, ζ)
    (g := fun m => if m = 1 then 1 else 0)).mp
    (fun m hm => sum_divisors_sum_primitiveRoots hm) n hn
  rw [← key, Finset.sum_eq_single (n, 1)]
  · simp
  · rintro ⟨a, b⟩ hab hne
    have hb : b ≠ 1 := by
      rintro rfl
      rw [Nat.mem_divisorsAntidiagonal] at hab
      exact hne (by rw [← hab.1, mul_one])
    simp [hb]
  · intro h
    exact absurd (by simp [Nat.mem_divisorsAntidiagonal, hn.ne']) h

/-! ## (d) The least common multiple and `ψ` -/

/-- `log lcm(1, …, n) = ∑_{m ≤ n} Λ(m)`.
(Mathlib: `Chebyshev.psi_eq_log_lcmUpto`, with `ψ` and `Nat.lcmUpto` unfolded.) -/
theorem log_lcm_Icc_eq_sum_vonMangoldt (n : ℕ) :
    Real.log ((Finset.Icc 1 n).lcm id : ℕ) =
      ∑ m ∈ Finset.Icc 1 n, ArithmeticFunction.vonMangoldt m := by
  have h1 : Chebyshev.psi (n : ℝ) = ∑ m ∈ Finset.Icc 1 n, ArithmeticFunction.vonMangoldt m := by
    simp [Chebyshev.psi, ← Finset.Icc_add_one_left_eq_Ioc]
  rw [← h1, Chebyshev.psi_eq_log_lcmUpto]
  rfl

/-- `log lcm(1, …, n + 1) - log lcm(1, …, n) = Λ(n + 1)`. In particular the least common
multiple of `1, …, n` changes at `n + 1` exactly when `n + 1` is a prime power. -/
theorem log_lcm_succ_sub_log_lcm (n : ℕ) :
    Real.log ((Finset.Icc 1 (n + 1)).lcm id : ℕ) - Real.log ((Finset.Icc 1 n).lcm id : ℕ) =
      ArithmeticFunction.vonMangoldt (n + 1) := by
  rw [log_lcm_Icc_eq_sum_vonMangoldt, log_lcm_Icc_eq_sum_vonMangoldt,
    Finset.sum_Icc_succ_top (by omega)]
  ring

end BuildingBlocks.PrimeBirth
