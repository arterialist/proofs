  "formalScope": "Six finite declarations: factor-pair reindexing, complete Mobius divisor sum, product coefficient, small-product cancellation, strict complement, and weighted hyperbola grouping. No analytic bound is assumed or formalized.",
  "writtenEstimate": {
    "file": "building-blocks/hyperbola-product.md",
    "statement": "For every delta>0, positive integer N, integer sqrt(N)<=K<=N/2 and real K<=y<=2K, |sum_(K<k<=y) a_N(k)({N/k}-1/2)| <<_delta N^delta K^(4/3)N^(-1/3). Summing product bands through N^(5/8) gives O_delta(N^(1/2+delta)).",
    "status": "Written proof checked against the cited classical derivative and Fourier estimates; not Lean-verified.",
    "limit": "No improved complete prime-error bound or zero-location theorem."
  },
  "mathematicalNovelty": "Specialized application of classical methods; exact publication priority unresolved, no originality claim.",
  "formalizationPriority": "Not established; no first-formalization claim.",
  "utility": "Converts a restricted product sum to unweighted inner intervals and controls its low-product contribution.",
